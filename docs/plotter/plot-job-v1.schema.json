{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-map-plotter.invalid/schemas/plot-job-v1.schema.json",
  "title": "City Map Plotter plot job v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "source",
    "page_mm",
    "order",
    "device_profile",
    "machine",
    "preflight",
    "geometry",
    "stats",
    "safety",
    "pen_groups",
    "job_sha256"
  ],
  "properties": {
    "schema": {
      "const": "city-map-plotter/plot-job-v1"
    },
    "job_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "page_mm": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "order": {
      "enum": ["document", "merged", "optimised"]
    },
    "device_profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "pen_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pen", "strokes"],
        "properties": {
          "pen": {
            "type": "object",
            "required": ["id", "nib_mm", "calibration_state"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "nib_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "calibration_state": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "strokes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["layer", "points_mm"],
              "properties": {
                "points_mm": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
