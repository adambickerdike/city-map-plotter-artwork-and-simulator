{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adambickerdike/city-map-plotter/contracts/f1-circuits-2026/catalog-schema.json",
  "title": "Frozen 2026 circuit catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "season",
    "freeze",
    "sources",
    "events",
    "excluded_calendar_events"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "f1-circuits-2026"},
    "season": {"const": 2026},
    "freeze": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 30,
      "items": {"$ref": "#/$defs/source"}
    },
    "events": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {"$ref": "#/$defs/event"}
    },
    "excluded_calendar_events": {"type": "array", "minItems": 2}
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sourceObject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["node", "way", "relation"]},
        "id": {"type": "integer", "minimum": 1},
        "version": {"type": "integer", "minimum": 1},
        "timestamp": {"type": "string"},
        "tags": {"type": "object"}
      },
      "additionalProperties": true
    },
    "lineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/point"}
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "geometry": {"type": "object"},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "source_kind",
        "publisher",
        "url",
        "path",
        "retrieved_at",
        "sha256",
        "payload_sha256",
        "compressed_sha256",
        "licence",
        "commercial_use_status",
        "allowed_uses",
        "attribution"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "compressed_sha256": {"$ref": "#/$defs/sha256"},
        "licence": {"type": "string", "minLength": 1},
        "commercial_use_status": {"type": "string", "minLength": 1},
        "allowed_uses": {"type": "array", "items": {"type": "string"}},
        "attribution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "turnStation": {
      "type": "object",
      "required": [
        "number",
        "point",
        "station_fraction",
        "source_ref",
        "anchor_method",
        "status"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "point": {"$ref": "#/$defs/point"},
        "station_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "anchor_method": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "contextFeature": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "geometry",
        "source_ref",
        "source_objects",
        "tags",
        "temporary_status",
        "valid_for_season"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "water",
            "grass",
            "woodland",
            "grandstand",
            "principal-building",
            "building",
            "road",
            "access-road",
            "runoff",
            "gravel-trap",
            "paddock",
            "garage",
            "pit-building"
          ]
        },
        "name": {"type": ["string", "null"]},
        "geometry": {"type": "object"},
        "source_ref": {"type": "string", "minLength": 1},
        "source_objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceObject"}
        },
        "tags": {"type": "object"},
        "temporary_status": {"type": "string", "minLength": 1},
        "valid_for_season": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": [
        "model_version",
        "coordinate_system",
        "origin_wgs84",
        "lap",
        "lap_source_objects",
        "pit_lanes",
        "track_boundaries",
        "context",
        "turn_stations",
        "start_finish",
        "special_sections",
        "operational_overlays",
        "source_ref",
        "assembly",
        "geometry_sha256"
      ],
      "properties": {
        "model_version": {"const": 1},
        "coordinate_system": {"const": "local-metre"},
        "origin_wgs84": {"$ref": "#/$defs/point"},
        "lap": {"$ref": "#/$defs/feature"},
        "lap_source_objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceObject"}
        },
        "pit_lanes": {"type": "array"},
        "track_boundaries": {"type": "array"},
        "context": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextFeature"}
        },
        "turn_stations": {
          "type": "array",
          "items": {"$ref": "#/$defs/turnStation"}
        },
        "start_finish": {"type": ["object", "null"]},
        "special_sections": {"type": "array"},
        "operational_overlays": {"type": "object"},
        "source_ref": {"type": "string", "minLength": 1},
        "assembly": {"type": "object"},
        "geometry_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "fastestLap": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "time", "time_ms", "driver", "season", "source_label", "source_ref", "claim_scope"],
          "properties": {
            "status": {"const": "source-backed"},
            "time": {"type": "string", "pattern": "^[0-9]+:[0-5][0-9]\\.[0-9]{3}$"},
            "time_ms": {"type": "integer", "minimum": 1},
            "driver": {"type": "string", "minLength": 1},
            "season": {"type": "integer", "minimum": 1950, "maximum": 2026},
            "source_label": {"const": "Fastest lap time"},
            "source_ref": {"type": "string", "minLength": 1},
            "claim_scope": {"const": "formula1-official-page-fastest-lap-time"},
            "team_source_copy": {"type": "string", "minLength": 1},
            "driver_key": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source_label", "source_ref", "withheld_reason", "claim_scope"],
          "properties": {
            "status": {"const": "withheld"},
            "source_label": {"const": "Fastest lap time"},
            "source_ref": {"type": "string", "minLength": 1},
            "withheld_reason": {"type": "string", "minLength": 1},
            "claim_scope": {"const": "formula1-official-page-fastest-lap-time"}
          }
        }
      ]
    },
    "officialFacts": {
      "type": "object",
      "additionalProperties": true,
      "required": ["page_title", "official_circuit_length_m", "number_of_laps", "race_distance_km", "first_grand_prix", "fastest_lap", "official_track_stats", "source_ref", "claim_scope"],
      "properties": {
        "page_title": {"type": ["string", "null"]},
        "official_circuit_length_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "number_of_laps": {"type": ["integer", "null"], "minimum": 1},
        "race_distance_km": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "first_grand_prix": {"type": ["integer", "null"], "minimum": 1950, "maximum": 2026},
        "fastest_lap": {"$ref": "#/$defs/fastestLap"},
        "official_track_stats": {"type": ["object", "null"]},
        "source_ref": {"type": "string", "minLength": 1},
        "claim_scope": {"const": "factual-transcription-only-no-map-image-use"}
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "calendar_order",
        "calendar_status",
        "event_identity",
        "neutral_display_title",
        "event_country_iso2",
        "host_country_iso2",
        "approval",
        "official_facts",
        "circuit",
        "sources",
        "rights",
        "review"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "calendar_order": {"type": "integer", "minimum": 1, "maximum": 23},
        "calendar_status": {"enum": ["confirmed", "conditional"]},
        "event_identity": {"type": "string", "minLength": 1},
        "neutral_display_title": {"type": "string", "minLength": 1},
        "event_country_iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "host_country_iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "approval": {"type": "object"},
        "official_facts": {"$ref": "#/$defs/officialFacts"},
        "circuit": {
          "type": "object",
          "required": ["id", "official_name", "site_type", "geometry"],
          "properties": {
            "id": {"$ref": "#/$defs/stableId"},
            "official_name": {"type": "string", "minLength": 1},
            "site_type": {
              "enum": ["permanent", "street", "temporary", "semi-permanent", "hybrid"]
            },
            "geometry": {
              "type": "object",
              "required": ["status", "model", "review"],
              "properties": {
                "status": {
                  "enum": ["source-qualified", "cartography-qualified-centreline", "unavailable", "withheld", "pending", "provisional"]
                },
                "source_ref": {"type": "string", "minLength": 1},
                "model": {"oneOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]},
                "review": {"type": "object"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "sources": {"type": "object"},
        "rights": {"type": "object"},
        "review": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
