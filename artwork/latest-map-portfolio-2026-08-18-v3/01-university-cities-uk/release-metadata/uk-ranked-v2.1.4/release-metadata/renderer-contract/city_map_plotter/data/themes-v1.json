{
  "schema_version": 2,
  "id": "city-map-plotter-themes-v2",
  "themes": [
    {
      "id": "city-memorabilia-a5-series-v1",
      "version": 2,
      "label": "A5 city memorabilia — centred stack",
      "description": "The classic composition: full-colour hierarchy, a double border, and a centred title over the map with the details beneath it.",
      "format": {"contract_id": "plate-format-v1", "format_id": "a5-portrait"},
      "export": {
        "canonical_args": [
          "--preset", "a5-balanced-poster",
          "--radius-km", "2",
          "--layers", "roads,water,railways,parks",
          "--detail-profile", "ink-balanced",
          "--simplify-mm", "0.04",
          "--road-style", "centreline",
          "--extent-fit", "contain",
          "--pen-profile", "actual-pens",
          "--stock-tone", "light",
          "--attribution-mode", "external",
          "--external-attribution-placement", "Product page, packaging, or caption adjacent to each artwork",
          "--no-scale-bar",
          "--no-scale-detail",
          "--optimise",
          "--physical-audit"
        ],
        "locked_options": [
          "--preset", "--radius-km", "--layers", "--detail-profile", "--simplify-mm",
          "--road-style", "--extent-fit", "--pen-profile", "--stock-tone",
          "--attribution-mode", "--external-attribution-placement",
          "--scale-bar", "--no-scale-bar", "--scale-detail", "--no-scale-detail",
          "--optimise", "--optimize", "--no-optimise", "--no-optimize",
          "--physical-audit", "--no-physical-audit",
          "--style", "--title", "--subtitle", "--detail",
          "--paper", "--orientation", "--width-mm", "--height-mm", "--margin-mm",
          "--nib-mm", "--png-dpi", "--allow-repeat-passes"
        ]
      },
      "map_layers": [
        {"id": "water_areas",     "ink": "Blue",  "nib_role": "primary",  "order": 10},
        {"id": "rivers",          "ink": "Blue",  "nib_role": "primary",  "order": 15},
        {"id": "waterways",       "ink": "Blue",  "nib_role": "hairline", "order": 20},
        {"id": "green_space",     "ink": "Green", "nib_role": "hairline", "order": 30},
        {"id": "road_areas",      "ink": "Grey",  "nib_role": "hairline", "order": 55},
        {"id": "roads_major",     "ink": "Black", "nib_role": "heavy",    "order": 60},
        {"id": "roads_secondary", "ink": "Black", "nib_role": "primary",  "order": 80},
        {"id": "roads_local",     "ink": "Black", "nib_role": "text",     "order": 90},
        {"id": "roads_other",     "ink": "Grey",  "nib_role": "hairline", "order": 100},
        {"id": "paths",           "ink": "Grey",  "nib_role": "hairline", "order": 110},
        {"id": "railways",        "ink": "Red",   "nib_role": "hairline", "order": 120}
      ],
      "furniture": {
        "poster_border":   {"draws": true,  "ink": "Black", "nib_role": "heavy",    "style": "double"},
        "frame":           {"draws": true,  "ink": "Black", "nib_role": "primary"},
        "map_furniture":   {"draws": true,  "ink": "Black", "nib_role": "text", "north_mark": "field-north-east", "scale_bar": false},
        "poster_title":    {"draws": true,  "ink": "Black", "nib_role": "heavy",    "weight": 1},
        "poster_subtitle": {"draws": true,  "ink": "Black", "nib_role": "text",     "weight": 1},
        "poster_details":  {"draws": true,  "ink": "Black", "nib_role": "text",     "weight": 1},
        "attribution":     {"draws": false, "ink": "Black", "nib_role": "hairline", "weight": 1}
      },
      "typography": {
        "policy_id": "city-memorabilia-type-v1",
        "font_roles": {"display": "plotter-grid-v3", "text": "plotter-grid-v3", "mono": "plotter-grid-v3"},
        "normalisation_policy_id": "nfkd-latin-transliteration-v1",
        "roles": {
          "title":       {"font_role": "display", "zone": "title",       "align": "centre", "vertical": "top",    "case": "upper", "max_lines": 2, "cap_role": "title",       "cap_scale": 1.0, "gutter": 2.7},
          "subtitle":    {"font_role": "text",    "zone": "subtitle",    "align": "centre", "vertical": "middle", "case": "upper", "max_lines": 1, "cap_role": "subtitle",    "cap_scale": 1.0, "gutter": 4.0},
          "detail":      {"font_role": "text",    "zone": "detail",      "align": "centre", "vertical": "middle", "case": "upper", "max_lines": 3, "cap_role": "detail",      "cap_scale": 1.0, "gutter": 3.3},
          "legend":      {"font_role": "mono",    "zone": "map_field",   "align": "left",   "vertical": "top",    "case": "upper", "max_lines": 1, "cap_role": "legend",      "cap_scale": 1.0},
          "attribution": {"font_role": "text",    "zone": "attribution", "align": "split",  "vertical": "middle", "case": "mixed", "max_lines": 1, "cap_role": "attribution", "cap_scale": 1.0}
        }
      },
      "copy": {
        "policy_id": "city-memorabilia-copy-v1",
        "rules": {
          "campus": {"title": "subject.name", "subtitle": "city-country", "details": ["purpose", "coordinates"]},
          "student_city": {"title": "city", "subtitle": "country", "details": ["purpose", "coordinates"]},
          "city_preview": {"title": "city", "subtitle": "country", "details": ["purpose", "course-disclosure", "coordinates"]}
        }
      },
      "placement_policy_id": "plate-format-named-zones-v1",
      "source_policy_id": "selected-family-lineage-relative-to-source-v1",
      "validation_policy_id": "format-physical-source-and-cohort-v1",
      "batch": {"title_mode": "theme", "recommended_png_dpi": 254, "cohort_key": "edition_signature_sha256"}
    },

